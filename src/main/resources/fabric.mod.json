{
  "schemaVersion": 1,
  "id": "iem_compatibility",
  "version": "${version}",
  "name": "IEM_Compatibility",
  "description": "IEM client rendering integration and spatial audio.",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/iem_compatibility/icon.png",
  "environment": "client",
  "entrypoints": {
    "modmenu": [
      "com.ruskserver.iem_compatibility.client.IemModMenu"
    ],
    "fabric-datagen": [
      "com.ruskserver.iem_compatibility.client.Iem_compatibilityDataGenerator"
    ],
    "client": [
      "com.ruskserver.iem_compatibility.client.Iem_compatibilityClient"
    ],
    "main": [
      "com.ruskserver.iem_compatibility.Iem_compatibility"
    ]
  },
  "mixins": [
    "iem_compatibility.mixins.json",
    {
      "config": "iem_compatibility.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "yet_another_config_lib_v3": ">=3.9.7"
  },
  "suggests": {"modmenu": "*"}
}
